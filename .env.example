# MLX ASR Runtime Path
# Path to the qwen3-asr-mlx-runtime bridge script or binary.
# If using the standalone runtime:
MLX_ASR_RUNTIME_PATH=/path/to/qwen3-asr-mlx-runtime/scripts/qwen3-asr-mlx-bridge

# Model identifier for Qwen3-ASR (HuggingFace)
MLX_ASR_MODEL=Qwen/Qwen3-ASR-1.7B

# Optional: Local LLM endpoint for post-processing (Ollama or LM Studio)
# Leave empty to disable LLM post-processing
LLM_ENDPOINT=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b